# x402-wallet-mcp — copy the block for ONE provider into your MCP client config
# (the "env" section) or into .env for the CLI / integration tests.
# Never commit real values.

# ---------------------------------------------------------------- required
# cdp | privy | crossmint | none (none = discovery tools only, no wallet)
WALLET_PROVIDER=cdp

# ---------------------------------------------------------------- cdp
# API key (JSON download):  https://portal.cdp.coinbase.com/api-keys/secret
# Wallet secret:            https://portal.cdp.coinbase.com/wallets/non-custodial/security
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# Optional: name of the CDP account to create/reuse (default x402-wallet-mcp)
# CDP_ACCOUNT_NAME=x402-wallet-mcp

# ---------------------------------------------------------------- privy
# App ID + App secret: https://dashboard.privy.io/apps?page=settings&tab=basics
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Server wallet ids. Create with: npx x402-wallet-mcp privy-create-wallet [ethereum|solana]
PRIVY_WALLET_ID=
# PRIVY_SOLANA_WALLET_ID=
# Only if the wallet has an owner / authorization key:
# PRIVY_AUTHORIZATION_PRIVATE_KEY=
# Only if the app uses Privy gas sponsorship (smart-wallet signatures):
# PRIVY_SIGNATURE_TYPE=erc1271

# ---------------------------------------------------------------- crossmint
# Server-side key (staging = sk_staging_...): https://staging.crossmint.com/console/projects/apiKeys
# (CROSSMINT_API_KEY is accepted as an alias)
CROSSMINT_SERVER_API_KEY=
# 32-byte signer secret. Generate with: npx x402-wallet-mcp crossmint-gen-secret
CROSSMINT_SIGNER_SECRET=
# Wallet address. Create with: npx x402-wallet-mcp crossmint-create-wallet
CROSSMINT_WALLET_ADDRESS=

# ---------------------------------------------------------------- nevermined (optional)
# sandbox:... or live:... key from https://nevermined.app -> Settings -> Global NVM API Keys
# Must match config.json "network": testnet -> sandbox: key, mainnet -> live: key.
# NVM_API_KEY=sandbox:...
# Seller key used only by scripts/nvm-sandbox-seller.ts (sandbox: key)
# NVM_API_KEY_SELLER=sandbox:...
# Recommended: a delegation you created (spend cap + expiry). If unset, one is created
# on first use, capped at perSessionMaxUsd for 24h.
# NVM_DELEGATION_ID=
# Payment method for the auto-created delegation (default: first active erc4337 wallet)
# NVM_PAYMENT_METHOD_ID=

# ---------------------------------------------------------------- private pricing (optional, Solana devnet)
# Arcium MXE program of kato9292929/x402-private-pricing. Setting it adds
# private_price_match / private_quote_auction (WALLET_PROVIDER cdp or privy, network testnet).
# ARCIUM_MXE_PROGRAM_ID=
# Devnet-only keypair (JSON array of 64 numbers) with devnet SOL only; pays the MPC fees.
# ARCIUM_FEE_PAYER_KEYPAIR=
# ARCIUM_CLUSTER_OFFSET=456
# ARCIUM_RFQ_DURATION_SEC=

# ---------------------------------------------------------------- optional
# Order of schemes to try when a 402 offers several (default: exact,nvm:erc4337)
# SCHEME_PRIORITY=exact,nvm:erc4337
# Directory for config.json / payments.jsonl (default ~/.x402-wallet-mcp)
# X402_WALLET_MCP_HOME=
# Custom RPCs for balance reads
# BASE_RPC_URL=
# BASE_SEPOLIA_RPC_URL=
# SOLANA_RPC_URL=
# SOLANA_DEVNET_RPC_URL=
